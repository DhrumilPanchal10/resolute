# Database
DATABASE_URL=postgresql+psycopg://resolute:resolute@localhost:5432/resolute

# Redis
REDIS_URL=redis://localhost:6379/0

# LLM models (via LiteLLM)
MODEL_SMALL=gemini/gemini-3.1-flash-lite
MODEL_STRONG=gemini/gemini-3.8-flash
MODEL_JUDGE=gemini/gemini-3.1-flash-lite

# LLM provider keys
GEMINI_API_KEY=
GROQ_API_KEY=

# Auth (Clerk)
CLERK_SECRET_KEY=
CLERK_JWKS_URL=

# Tracing (Langfuse or Phoenix)
OTLP_ENDPOINT=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# GitHub (for issue collection)
GITHUB_TOKEN=

# Stripe (test mode)
STRIPE_SECRET_KEY=sk_test_

# Offline mode (set to 1 in CI / unit tests)
OFFLINE=0

# Budget limits (USD per run)
BUDGET_USD_MAX=0.10
